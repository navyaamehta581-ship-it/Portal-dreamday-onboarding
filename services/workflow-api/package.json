{
  "name": "@portal-architect/workflow-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "demo": "node scripts/demo.ts",
    "demo:token": "node scripts/demo.ts token",
    "demo:operator-token": "node scripts/demo.ts operator-token",
    "demo:handoff": "node scripts/demo.ts handoff",
    "handoff:scenarios": "node scripts/handoff-scenarios.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
